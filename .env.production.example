APP_NAME="Kuchařka"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Deployment-specific canonical HTTPS URL.
APP_URL=https://cookbook.example.com

# Stable PEM key material supplied through deployment secrets; rotate deliberately.
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

APP_LOCALE=cs
APP_FALLBACK_LOCALE=cs

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mariadb
# Deployment-specific MariaDB endpoint and schema identity.
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=cookbook
DB_USERNAME=cookbook
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
# No production worker is required while the application has no queued jobs.
QUEUE_CONNECTION=sync

# Persist /var/www/storage/app from the Komodo stack. Family media stays private
# by default; a future S3 migration can replace this disk contract.
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
